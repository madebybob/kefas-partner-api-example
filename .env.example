# The Kefas API host. A preview environment works too, e.g. https://pr-825.kefas.dev
KEFAS_API_URL=https://web.kefas.app

# Your organisation token. Secret: it stays on this server and is never sent to a browser.
KEFAS_ORGANISATION_TOKEN=

# Your own id for the example channel (the external_id in Kefas).
CHANNEL_EXTERNAL_ID=kefas-partner-api-example

PORT=3000
